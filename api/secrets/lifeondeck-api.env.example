# Copy to lifeondeck-api.env (gitignored) and fill real values for production.
# ASP.NET Core reads these via the environment-variable config provider.
# Nested keys use double underscore: ConnectionStrings:Default -> ConnectionStrings__Default

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL connection string
ConnectionStrings__Default=Host=gmarra.it:5432;Database=lifeondeck;Username=LifeOnDeckAdmin;Password=CHANGE_ME

# JWT signing key, min 32 chars
Jwt__SecretKey=CHANGE_ME_min_32_chars
